# ---- Local development defaults. Copy to apps/api/.env ----
NODE_ENV=development
APP_URL=http://localhost:3100
API_URL=http://localhost:4100
PORT=4100
LOG_LEVEL=debug

# App connects as a non-superuser so RLS is enforced. Migrations use the owner URL.
DATABASE_URL=postgresql://tripos_app:tripos_app_dev_only@localhost:5442/tripos
DATABASE_MIGRATE_URL=postgresql://tripos:tripos_dev_only@localhost:5442/tripos

SESSION_SECRET=dev-only-session-secret-change-me-0123456789abcdef
APP_ENCRYPTION_KEY=dev-only-encryption-key-32-chars!!
AUTH_PROVIDER=password

STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=./storage
STORAGE_SIGNING_SECRET=dev-only-storage-signing-secret

WHATSAPP_PROVIDER=simulator
AI_PROVIDER=mock
EMAIL_PROVIDER=console

# Public address of the customer quotation page (/q/<token>) used in WhatsApp links. Defaults to APP_URL; https in production.
# PUBLIC_QUOTE_BASE_URL=
# Needed to submit WhatsApp templates with image/document headers (Meta Resumable Upload).
# WHATSAPP_APP_ID=
# Embedded Signup v4 (coexistence). Off unless set to true; the manual connection keeps working either way.
# Second Meta app for Embedded Signup v4. All three or none; never borrowed from the values above.
# Its webhooks go to /webhooks/whatsapp/signup (the original app keeps /webhooks/whatsapp).
# WHATSAPP_SIGNUP_APP_ID=
# WHATSAPP_SIGNUP_APP_SECRET=
# WHATSAPP_SIGNUP_VERIFY_TOKEN=
# Requires WHATSAPP_APP_ID (the original app) to be set as well.
# JSON body limit for /webhooks/* only, in bytes (default 4194304; Meta documents payloads up to 3 MB).
# WHATSAPP_WEBHOOK_MAX_BODY_BYTES=4194304
# WHATSAPP_EMBEDDED_SIGNUP_ENABLED=false
# WHATSAPP_EMBEDDED_SIGNUP_CONFIG_ID=
