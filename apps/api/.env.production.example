# Production template. Placeholders only. Real values live in your host's secret manager, never in git.
# Startup FAILS (by design) if any of these are missing, weak, or left at a development default.
NODE_ENV=production
APP_URL=https://app.example.com
API_URL=https://api.example.com
PORT=4100
LOG_LEVEL=info

# Runtime role must be a NON-superuser (so row-level security is enforced). Migrations use the owner URL.
DATABASE_URL=postgresql://tripos_app:CHANGE_ME@db.example.com:5432/tripos?sslmode=require
DATABASE_MIGRATE_URL=postgresql://tripos_owner:CHANGE_ME@db.example.com:5432/tripos?sslmode=require

SESSION_SECRET=<48+ random chars>
APP_ENCRYPTION_KEY=<48+ random chars; losing it makes stored WhatsApp tokens unreadable>
AUTH_PROVIDER=password

STORAGE_PROVIDER=s3
STORAGE_ENDPOINT=                      # blank for AWS S3; set for R2/MinIO/etc.
STORAGE_BUCKET=tripos-prod-private
STORAGE_REGION=ap-south-1
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_SIGNING_SECRET=<random>
SIGNED_URL_TTL_SECONDS=300

WHATSAPP_PROVIDER=cloud
WHATSAPP_API_BASE_URL=https://graph.facebook.com/v21.0
WHATSAPP_APP_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=<random>

AI_PROVIDER=openai                     # or "disabled"
AI_MODEL=gpt-4o-mini
AI_API_KEY=
AI_TIMEOUT_MS=15000

EMAIL_PROVIDER=resend
EMAIL_API_KEY=
EMAIL_FROM=Agency Name <no-reply@example.com>
